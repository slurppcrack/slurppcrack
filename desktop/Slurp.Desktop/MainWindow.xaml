<Window x:Class="Slurp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SLURP" Height="900" Width="1440" MinHeight="640" MinWidth="1060"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SendButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#0A0F06" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="shadow" Fill="#33C6FF4A" Margin="-3" />
                            <Ellipse x:Name="circle" Fill="{TemplateBinding Background}" />
                            <Path x:Name="arrow" Data="M8,13 L8,3 M3.5,7.5 L8,3 L12.5,7.5"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circle" Property="Fill" Value="#D4FF72" />
                                <Setter TargetName="shadow" Property="Fill" Value="#55C6FF4A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="circle" Property="Fill" Value="#B4E840" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="circle" Property="Fill" Value="#242429" />
                                <Setter TargetName="shadow" Property="Fill" Value="Transparent" />
                                <Setter Property="Foreground" Value="#6A6A73" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- message row: fades and slides in when it appears -->
        <DataTemplate x:Key="MessageTemplate">
            <Grid x:Name="row" Opacity="1" Margin="0,0,0,16">
                <Grid.RenderTransform>
                    <TranslateTransform Y="10" />
                </Grid.RenderTransform>
                <Border x:Name="userBubble" Style="{StaticResource UserBubble}" Visibility="Collapsed">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13.5" LineHeight="21" />
                </Border>
                <Grid x:Name="assistantRow" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource AccentMark}"
                            VerticalAlignment="Top" Margin="0,1,12,0">
                        <TextBlock Text="s" Foreground="#0A0F06" FontWeight="Bold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13.5"
                               LineHeight="22" Foreground="{StaticResource TextSoft}" MaxWidth="720"
                               HorizontalAlignment="Left" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter TargetName="userBubble" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsUser}" Value="False">
                    <Setter TargetName="assistantRow" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="row">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="row" Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.22" />
                            <DoubleAnimation Storyboard.TargetName="row"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             To="0" Duration="0:0:0.34">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- activity entry -->
        <DataTemplate x:Key="ActivityTemplate">
            <Border x:Name="card" Style="{StaticResource ToolLine}" Opacity="1">
                <Border.RenderTransform>
                    <TranslateTransform X="-6" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="bar" Width="2" CornerRadius="2" Background="#2B2B33" Margin="0,1,8,1" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                   Foreground="#D5D5DC" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Result}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                   Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis"
                                   MaxHeight="16" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Ok}" Value="True">
                    <Setter TargetName="bar" Property="Background" Value="{StaticResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Ok}" Value="False">
                    <Setter TargetName="bar" Property="Background" Value="{StaticResource Danger}" />
                </DataTrigger>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="card">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="card" Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="card"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                             To="0" Duration="0:0:0.26">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid" Opacity="1" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== title bar ==================== -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="#0A0A0B" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Border Width="22" Height="22" CornerRadius="7" Background="{StaticResource AccentMark}">
                    <TextBlock Text="s" Foreground="#0A0F06" FontWeight="Bold" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="slurp" FontSize="13.5" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                <Border Style="{StaticResource Pill}" Padding="6,3" Margin="9,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="0.9.5" Style="{StaticResource CapText}" />
                </Border>
                <TextBlock x:Name="TitleSubtitle" Text="— агент в твоей папке" FontSize="12"
                           Foreground="{StaticResource Dim}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Свернуть">
                    <Path Data="M0,0 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1" />
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Развернуть">
                    <Path Data="M0.5,0.5 H9.5 V9.5 H0.5 Z"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1" />
                </Button>
                <Button Style="{StaticResource CaptionCloseButton}" Click="Close_Click" ToolTip="Закрыть">
                    <Path Data="M0,0 L9,9 M9,0 L0,9"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.1" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== body ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="262" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- =============== sidebar =============== -->
            <Border Grid.Column="0" Background="{StaticResource Sidebar}"
                    BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,1,0">
                <Grid Margin="10,12,10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button x:Name="NewSessionButton" Style="{StaticResource NewSessionButton}" Click="NewSession_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M6,0 V12 M0,6 H12" Stroke="{StaticResource Muted}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                            <TextBlock Text="Новая сессия" Margin="8,0,0,0" FontSize="12.5" />
                        </StackPanel>
                    </Button>

                    <Grid Grid.Row="1" Margin="6,18,6,8">
                        <TextBlock Text="НЕДАВНИЕ" Style="{StaticResource CapText}" />
                        <TextBlock x:Name="SessionsCount" Text="0" Style="{StaticResource CapText}"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <ListBox x:Name="SessionsList" Grid.Row="2" Style="{StaticResource SessionList}"
                             SelectionChanged="SessionsList_SelectionChanged" />

                    <StackPanel Grid.Row="3">
                        <Button x:Name="WorkspaceCardButton" Click="PickFolder_Click" Cursor="Hand" Margin="0,0,0,8">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="#111115" BorderBrush="{StaticResource Line}"
                                            BorderThickness="1" CornerRadius="10" Padding="10">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="BorderBrush" Value="#33333D" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M1,2 H5 L6.4,3.8 H13 V11 H1 Z" Stroke="#9AA08F" StrokeThickness="1.2"
                                          StrokeLineJoin="Round" VerticalAlignment="Center" />
                                    <TextBlock x:Name="WorkspaceName" Text="выбрать папку…" FontSize="12.5"
                                               FontWeight="SemiBold" Margin="7,0,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="WorkspacePath" Text="агент работает только внутри неё"
                                           Style="{StaticResource CapText}" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="OpenFolderButton" Content="Папка" Style="{StaticResource GhostButton}"
                                    Height="30" Click="OpenFolder_Click" IsEnabled="False" />
                            <Button Grid.Column="2" Content="Настройки" Style="{StaticResource GhostButton}"
                                    Height="30" Click="Settings_Click" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- =============== main =============== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,0,6">
                    <StackPanel>
                        <!-- hero / empty state -->
                        <Grid x:Name="HeroPanel" Margin="0,10,0,0">
                            <Ellipse Height="420" Width="780" Fill="{StaticResource HeroGlow}" IsHitTestVisible="False"
                                     VerticalAlignment="Top" />
                            <StackPanel HorizontalAlignment="Center" MaxWidth="640" Margin="0,58,0,0">
                                <Border Style="{StaticResource Chip}" HorizontalAlignment="Center">
                                    <TextBlock Text="АГЕНТ · C# / WPF · ЛОКАЛЬНО" Style="{StaticResource CapText}"
                                               Foreground="#B9D68A" />
                                </Border>
                                <TextBlock Text="Что строим сегодня?" Style="{StaticResource DisplayText}"
                                           HorizontalAlignment="Center" Margin="0,20,0,10" />
                                <TextBlock Style="{StaticResource MutedText}" FontSize="13.5" LineHeight="21"
                                           TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="520"
                                           Text="SLURP читает твой проект, правит настоящие файлы и сам прогоняет сборку с тестами." />
                                <WrapPanel HorizontalAlignment="Center" Margin="0,24,0,0" MaxWidth="560">
                                    <Button Style="{StaticResource SuggestChip}" Click="Suggestion_Click"
                                            Content="Добавь валидацию в форму логина" />
                                    <Button Style="{StaticResource SuggestChip}" Click="Suggestion_Click"
                                            Content="Почему падает auth.spec.ts?" />
                                    <Button Style="{StaticResource SuggestChip}" Click="Suggestion_Click"
                                            Content="Сделай тёмную тему в settings.css" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Height="1" VerticalAlignment="Center" Background="{StaticResource LineSoft}" />
                            <TextBlock Grid.Column="1" x:Name="SessionTitle" Text="" Style="{StaticResource CapText}"
                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                        </Grid>

                        <ItemsControl x:Name="Messages" ItemTemplate="{StaticResource MessageTemplate}"
                                      Margin="30,16,30,0" MaxWidth="800" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </ScrollViewer>

                <!-- composer -->
                <StackPanel Grid.Row="1" Margin="26,4,26,16" MaxWidth="800" HorizontalAlignment="Stretch">
                    <Border x:Name="ComposerCard" BorderThickness="1" CornerRadius="16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource SurfaceGradient}" />
                                <Setter Property="BorderBrush" Value="#26262E" />
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="#3B4A24" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="34" ShadowDepth="12" Direction="270" Opacity="0.5"
                                              Color="#000000" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <TextBlock x:Name="Watermark" Text="Опиши задачу — или нажми / для команд"
                                           Foreground="#63636D" FontSize="13.5" Margin="16,14,16,0"
                                           VerticalAlignment="Top" IsHitTestVisible="False" />
                                <TextBox x:Name="Composer" Style="{StaticResource ComposerBox}"
                                         MinHeight="58" MaxHeight="180"
                                         KeyDown="Composer_KeyDown" TextChanged="Composer_TextChanged"
                                         GotKeyboardFocus="Composer_GotKeyboardFocus"
                                         LostKeyboardFocus="Composer_LostKeyboardFocus" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="10,2,10,10">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButton}" Click="PickFolder_Click" ToolTip="Сменить папку">
                                        <Path Data="M6,0 V12 M0,6 H12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Button>
                                    <Border Style="{StaticResource Pill}" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M1,2 H5 L6.4,3.8 H13 V11 H1 Z" Stroke="#9AA08F" StrokeThickness="1.2"
                                                  StrokeLineJoin="Round" VerticalAlignment="Center" />
                                            <TextBlock x:Name="WorkspacePill" Text="папка" FontSize="12" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <ComboBox x:Name="AutonomyCombo" Width="188" Margin="8,0,0,0"
                                              VerticalAlignment="Center" SelectionChanged="Autonomy_SelectionChanged" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ComboBox x:Name="ModelCombo" Width="216" VerticalAlignment="Center"
                                              SelectionChanged="ModelCombo_SelectionChanged" />
                                    <Button x:Name="SendButton" Style="{StaticResource SendButton}" Margin="8,0,0,0"
                                            Click="Send_Click" ToolTip="Отправить (Ctrl+Enter)" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="4,9,0,0">
                        <TextBlock Text="Ctrl+Enter" Style="{StaticResource CapText}" Foreground="{StaticResource Muted}" />
                        <TextBlock Text="отправить" Style="{StaticResource CapText}" Margin="5,0,14,0" />
                        <TextBlock Text="Esc" Style="{StaticResource CapText}" Foreground="{StaticResource Muted}" />
                        <TextBlock Text="стоп" Style="{StaticResource CapText}" Margin="5,0,14,0" />
                        <TextBlock Text="Ctrl+O" Style="{StaticResource CapText}" Foreground="{StaticResource Muted}" />
                        <TextBlock Text="папка" Style="{StaticResource CapText}" Margin="5,0,0,0" />
                        <TextBlock x:Name="CostText" Style="{StaticResource CapText}" HorizontalAlignment="Right"
                                   Margin="24,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- =============== right rail =============== -->
            <Border Grid.Column="2" Background="#0B0B0D" BorderBrush="{StaticResource LineSoft}"
                    BorderThickness="1,1,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,16,14,14">
                    <StackPanel>
                        <TextBlock Text="СЕССИЯ" Style="{StaticResource CapText}" Margin="1,0,0,9" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                            <StackPanel>
                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="модель" Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="InfoModel" Text="—" Style="{StaticResource CapText}"
                                               Foreground="{StaticResource Text}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="шагов" Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="InfoSteps" Text="0" Style="{StaticResource CapText}"
                                               Foreground="{StaticResource Text}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="токены" Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="InfoTokens" Text="0 / 0" Style="{StaticResource CapText}"
                                               Foreground="{StaticResource Text}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="стоимость" Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="InfoCost" Text="$0.0000" Style="{StaticResource CapText}"
                                               Foreground="{StaticResource Accent}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="АКТИВНОСТЬ" Style="{StaticResource CapText}" Margin="1,0,0,9" />
                        <ItemsControl x:Name="ActivityList" ItemTemplate="{StaticResource ActivityTemplate}" />
                        <TextBlock x:Name="ActivityEmpty" Text="пока ничего не происходило"
                                   Style="{StaticResource CapText}" Margin="1,2,0,0" />

                        <TextBlock Text="СОСТОЯНИЕ" Style="{StaticResource CapText}" Margin="1,20,0,9" />
                        <Border Style="{StaticResource Card}" Padding="11,9">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="RunDot" Width="6" Height="6" Fill="{StaticResource Accent}"
                                             VerticalAlignment="Center" Opacity="0.4" />
                                    <TextBlock x:Name="StatusText" Text="готов" FontSize="12"
                                               Foreground="{StaticResource TextSoft}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               MaxWidth="190" />
                                </StackPanel>
                                <Button x:Name="StopButton" Content="Стоп" Style="{StaticResource GhostButton}"
                                        HorizontalAlignment="Right" Padding="9,3" Height="24" FontSize="11"
                                        Visibility="Collapsed" Click="Stop_Click" />
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" LineHeight="18"
                                   Foreground="{StaticResource Dim}" Margin="1,18,0,0"
                                   Text="Каждая запись и каждая команда shell спрашивает разрешение в режиме Ask. Режим меняется в шапке композера." />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ==================== first run ==================== -->
        <Grid x:Name="OnboardingOverlay" Grid.RowSpan="2" Background="#F20A0A0B" Visibility="Collapsed">
            <Border Width="600" Background="#0D0D11" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="18" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="60" ShadowDepth="18" Direction="270" Opacity="0.6" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <Border Style="{StaticResource Chip}" HorizontalAlignment="Left">
                        <TextBlock Text="ПЕРВЫЙ ЗАПУСК" Style="{StaticResource CapText}" Foreground="#B9D68A" />
                    </Border>
                    <TextBlock Text="Агент, который живёт в твоей папке" Style="{StaticResource DisplayText}"
                               FontSize="26" Margin="0,16,0,8" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="13" LineHeight="21"
                               Text="SLURP — отдельное десктоп-приложение на C#/WPF. Он читает и правит настоящие файлы на диске, запускает сборку и тесты. Никакой браузерной обёртки." />

                    <StackPanel Margin="0,22,0,0">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="1" Style="{StaticResource CapText}" Foreground="{StaticResource Accent}" FontSize="11" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Выбери модель" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           Text="Claude, GPT, DeepSeek, Gemini, Kimi, Qwen, Mistral, OpenRouter или локальный Ollama." />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="2" Style="{StaticResource CapText}" Foreground="{StaticResource Accent}" FontSize="11" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Вставь ключ провайдера" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           Text="Ключ хранится только на этом компьютере и шифруется Windows DPAPI." />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="3" Style="{StaticResource CapText}" Foreground="{StaticResource Accent}" FontSize="11" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Укажи папку проекта" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           Text="Агент работает только внутри неё и не выходит за границы папки." />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                        <Button Content="Настройки и ключи" Style="{StaticResource PrimaryButton}" Click="OnboardingSettings_Click" />
                        <Button Content="Выбрать папку" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnboardingFolder_Click" />
                        <Button Content="Пропустить" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnboardingSkip_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
