<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==== Цвета (тёмная тема в стиле hone.gg) ==== -->
    <Color x:Key="Color.Bg">#07080B</Color>
    <Color x:Key="Color.BgSoft">#0B0D12</Color>
    <Color x:Key="Color.Surface">#101218</Color>
    <Color x:Key="Color.SurfaceAlt">#15171F</Color>
    <Color x:Key="Color.SurfaceHover">#1D2029</Color>
    <Color x:Key="Color.Stroke">#232733</Color>
    <Color x:Key="Color.StrokeSoft">#1A1E27</Color>
    <Color x:Key="Color.Text">#F2F4F9</Color>
    <Color x:Key="Color.TextMuted">#9AA3B5</Color>
    <Color x:Key="Color.TextDim">#6B7385</Color>
    <Color x:Key="Color.Accent">#FF7A18</Color>
    <Color x:Key="Color.Accent2">#FF3D6E</Color>
    <Color x:Key="Color.Green">#3EDC97</Color>
    <Color x:Key="Color.Red">#FF5C72</Color>
    <Color x:Key="Color.Yellow">#FFD166</Color>
    <Color x:Key="Color.Blue">#4FC3F7</Color>
    <Color x:Key="Color.Purple">#A97BFF</Color>

    <!-- ==== Кисти ==== -->
    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="Brush.BgSoft" Color="{StaticResource Color.BgSoft}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.Stroke" Color="{StaticResource Color.Stroke}" />
    <SolidColorBrush x:Key="Brush.StrokeSoft" Color="{StaticResource Color.StrokeSoft}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="{StaticResource Color.TextDim}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent2" Color="{StaticResource Color.Accent2}" />
    <SolidColorBrush x:Key="Brush.Green" Color="{StaticResource Color.Green}" />
    <SolidColorBrush x:Key="Brush.Red" Color="{StaticResource Color.Red}" />
    <SolidColorBrush x:Key="Brush.Yellow" Color="{StaticResource Color.Yellow}" />
    <SolidColorBrush x:Key="Brush.Blue" Color="{StaticResource Color.Blue}" />
    <SolidColorBrush x:Key="Brush.Purple" Color="{StaticResource Color.Purple}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#33FF7A18" />
    <SolidColorBrush x:Key="Brush.AccentSofter" Color="#1AFF7A18" />
    <SolidColorBrush x:Key="Brush.GreenSoft" Color="#263EDC97" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="#CC05060A" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#14110D" />

    <!-- ==== Градиенты ==== -->
    <LinearGradientBrush x:Key="Gradient.Accent" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Color.Accent}" Offset="0" />
        <GradientStop Color="{StaticResource Color.Accent2}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.AccentHorizontal" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource Color.Accent}" Offset="0" />
        <GradientStop Color="{StaticResource Color.Accent2}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Hero" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1FFFF7A18" Offset="0" />
        <GradientStop Color="#0DFF3D6E" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.ChartArea" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#5CFF7A18" Offset="0" />
        <GradientStop Color="#00FF3D6E" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Orange" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F5A623" Offset="0" />
        <GradientStop Color="#C2410C" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Green" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4ADE80" Offset="0" />
        <GradientStop Color="#166534" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Gradient.Purple" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A97BFF" Offset="0" />
        <GradientStop Color="#4C1D95" Offset="1" />
    </LinearGradientBrush>

    <!-- ==== Тени ==== -->
    <DropShadowEffect x:Key="Effect.CardShadow"
                      BlurRadius="26"
                      ShadowDepth="8"
                      Direction="270"
                      Opacity="0.45"
                      Color="#000000" />

    <DropShadowEffect x:Key="Effect.AccentGlow"
                      BlurRadius="34"
                      ShadowDepth="0"
                      Opacity="0.5"
                      Color="#FF7A18" />

</ResourceDictionary>
