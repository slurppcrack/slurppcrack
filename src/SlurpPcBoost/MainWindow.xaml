<Window x:Class="SlurpPcBoost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:conv="clr-namespace:SlurpPcBoost.Converters"
        xmlns:views="clr-namespace:SlurpPcBoost.Views"
        Title="Slurp PC Boost"
        Width="1380"
        Height="880"
        MinWidth="1120"
        MinHeight="700"
        Background="{StaticResource Brush.Bg}"
        FontFamily="{StaticResource Font.Ui}"
        Foreground="{StaticResource Brush.Text}"
        ResizeMode="CanResize"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        mc:Ignorable="d">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="68"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <!-- ============================ ШАПКА ============================ -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.BgSoft}"
                BorderBrush="{StaticResource Brush.StrokeSoft}"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38"
                            Height="38"
                            Background="{StaticResource Gradient.Accent}"
                            CornerRadius="12">
                        <Path Width="20"
                              Height="20"
                              Data="{StaticResource Icon.Bolt}"
                              Fill="{StaticResource Brush.OnAccent}"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="13.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text}"
                                   Text="SLURP PC BOOST" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="демо-оптимизатор для геймеров" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="26,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="1"
                            Height="26"
                            Background="{StaticResource Brush.Stroke}"
                            Margin="0,0,26,0" />
                    <TextBlock VerticalAlignment="Center"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text}"
                               Text="{Binding State.PageTitle}" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Command="{Binding ScanCommand}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource Btn.Soft}"
                            Margin="0,0,10,0"
                            ToolTip="Проанализировать систему">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}"
                                  Width="15"
                                  Height="15"
                                  Data="{StaticResource Icon.Scan}"
                                  Fill="{StaticResource Brush.Accent}" />
                            <TextBlock Margin="8,0,0,0" FontWeight="SemiBold" Text="Сканировать" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ApplyRecommendedCommand}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource Btn.Primary}"
                            Height="40"
                            Padding="18,0"
                            Margin="0,0,14,0"
                            ToolTip="Применить рекомендованные твики">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15"
                                  Height="15"
                                  Data="{StaticResource Icon.Bolt}"
                                  Fill="{StaticResource Brush.OnAccent}"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center" />
                            <TextBlock Margin="8,0,0,0" FontWeight="SemiBold" Text="Оптимизировать" />
                        </StackPanel>
                    </Button>

                    <Border Background="{StaticResource Brush.SurfaceAlt}"
                            BorderBrush="{StaticResource Brush.Stroke}"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="10,6"
                            Margin="0,0,10,0"
                            ToolTip="{Binding State.System.OsName}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}"
                                  Width="14"
                                  Height="14"
                                  Data="{StaticResource Icon.User}"
                                  Fill="{StaticResource Brush.TextMuted}" />
                            <TextBlock Margin="8,0,0,0"
                                       FontSize="12.5"
                                       Foreground="{StaticResource Brush.Text}"
                                       Text="{Binding State.System.UserName}" />
                        </StackPanel>
                    </Border>

                    <Button Click="Minimize_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource Btn.Window}"
                            ToolTip="Свернуть">
                        <Path Width="14"
                              Height="14"
                              Data="{StaticResource Icon.Minimize}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Stretch="Uniform" />
                    </Button>
                    <Button Click="Maximize_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource Btn.Window}"
                            ToolTip="Развернуть">
                        <Path x:Name="MaximizeIcon"
                              Width="14"
                              Height="14"
                              Data="{StaticResource Icon.Maximize}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Stretch="Uniform" />
                    </Button>
                    <Button Click="Close_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource Btn.WindowClose}"
                            ToolTip="Закрыть">
                        <Path Width="14"
                              Height="14"
                              Data="{StaticResource Icon.Close}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ ОСНОВНАЯ ЧАСТЬ ============================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Сайдбар -->
            <Border Grid.Column="0"
                    Background="{StaticResource Brush.BgSoft}"
                    BorderBrush="{StaticResource Brush.StrokeSoft}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="16,20,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Margin="14,0,0,10" Style="{StaticResource Text.Label}" Text="ОСНОВНОЕ" />

                        <RadioButton Command="{Binding NavigateCommand}"
                                     CommandParameter="dashboard"
                                     Content="Обзор системы"
                                     IsChecked="{Binding State.IsDashboardPage, Mode=OneWay}"
                                     Style="{StaticResource Nav.Button}"
                                     Tag="{StaticResource Icon.Dashboard}" />
                        <RadioButton Command="{Binding NavigateCommand}"
                                     CommandParameter="optimize"
                                     Content="Оптимизация"
                                     IsChecked="{Binding State.IsOptimizePage, Mode=OneWay}"
                                     Style="{StaticResource Nav.Button}"
                                     Tag="{StaticResource Icon.Bolt}" />
                        <RadioButton Command="{Binding NavigateCommand}"
                                     CommandParameter="games"
                                     Content="Игры"
                                     IsChecked="{Binding State.IsGamesPage, Mode=OneWay}"
                                     Style="{StaticResource Nav.Button}"
                                     Tag="{StaticResource Icon.Gamepad}" />
                        <RadioButton Command="{Binding NavigateCommand}"
                                     CommandParameter="logs"
                                     Content="Журнал"
                                     Style="{StaticResource Nav.Button}"
                                     Tag="{StaticResource Icon.Log}" />

                        <TextBlock Margin="14,20,0,10" Style="{StaticResource Text.Label}" Text="ПРОЧЕЕ" />

                        <RadioButton Command="{Binding NavigateCommand}"
                                     CommandParameter="settings"
                                     Content="Настройки"
                                     IsChecked="{Binding State.IsSettingsPage, Mode=OneWay}"
                                     Style="{StaticResource Nav.Button}"
                                     Tag="{StaticResource Icon.Settings}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <Border Background="{StaticResource Brush.AccentSofter}"
                                BorderBrush="{StaticResource Brush.AccentSoft}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Margin="0,0,0,10"
                                Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon}"
                                          Width="14"
                                          Height="14"
                                          Data="{StaticResource Icon.Alert}"
                                          Fill="{StaticResource Brush.Accent}" />
                                    <TextBlock Margin="8,0,0,0"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource Brush.Accent}"
                                               Text="ДЕМО-РЕЖИМ" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Text.Caption}"
                                           Margin="0,8,0,0"
                                           Text="Настройки Windows, реестр и сеть не изменяются — все действия имитируются." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card.Flat}" Padding="13">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="Твиков активно" />
                                    <TextBlock HorizontalAlignment="Right"
                                               FontFamily="{StaticResource Font.Numeric}"
                                               FontSize="12.5"
                                               Foreground="{StaticResource Brush.Text}"
                                               Text="{Binding State.AppliedCountText}" />
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="Прирост" />
                                    <TextBlock HorizontalAlignment="Right"
                                               FontFamily="{StaticResource Font.Numeric}"
                                               FontSize="12.5"
                                               Foreground="{StaticResource Brush.Accent}"
                                               Text="{Binding State.BoostPercentText}" />
                                </Grid>
                                <ProgressBar Margin="0,10,0,0"
                                             Style="{StaticResource Progress.Thin}"
                                             Value="{Binding State.OptimizationPercent}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Страницы -->
            <Grid Grid.Column="1" Margin="24,24,24,18">
                <views:DashboardView DataContext="{Binding Dashboard}"
                                     Visibility="{Binding State.IsDashboardPage, Converter={StaticResource BoolToVis}}" />
                <views:OptimizeView DataContext="{Binding Optimize}"
                                    Visibility="{Binding State.IsOptimizePage, Converter={StaticResource BoolToVis}}" />
                <views:GamesView DataContext="{Binding Games}"
                                 Visibility="{Binding State.IsGamesPage, Converter={StaticResource BoolToVis}}" />
                <views:SettingsView DataContext="{Binding Settings}"
                                    Visibility="{Binding State.IsSettingsPage, Converter={StaticResource BoolToVis}}" />
                <views:LogView DataContext="{Binding Log}"
                               Visibility="{Binding State.IsLogPage, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Grid>

        <!-- ============================ СТАТУС-БАР ============================ -->
        <Border Grid.Row="2"
                Background="{StaticResource Brush.BgSoft}"
                BorderBrush="{StaticResource Brush.StrokeSoft}"
                BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Green}" />
                    <TextBlock Margin="9,0,0,0"
                               Style="{StaticResource Text.Caption}"
                               Foreground="{StaticResource Brush.TextMuted}"
                               Text="{Binding State.StatusText}" />
                    <TextBlock Margin="16,0,0,0"
                               Style="{StaticResource Text.Caption}"
                               Foreground="{StaticResource Brush.Accent}"
                               Text="{Binding State.BusyText}"
                               Visibility="{Binding State.IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.Caption}">
                        <Run Text="База: " />
                        <Run FontWeight="SemiBold" Foreground="{StaticResource Brush.TextMuted}" Text="{Binding State.BaselineFps, Mode=OneWay}" />
                        <Run Text=" FPS" />
                    </TextBlock>
                    <TextBlock Margin="16,0,0,0" Style="{StaticResource Text.Caption}">
                        <Run Text="Сейчас: " />
                        <Run FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent}" Text="{Binding State.CurrentFps, Mode=OneWay}" />
                        <Run Text=" FPS" />
                    </TextBlock>
                    <TextBlock Margin="16,0,0,0"
                               Style="{StaticResource Text.Caption}"
                               Text="{Binding State.System.AppVersionText}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ ОВЕРЛЕЙ ЗАНЯТОСТИ ============================ -->
        <!-- Накрываем контент и статус-бар, но не шапку: кнопки окна остаются доступными. -->
        <Grid Grid.Row="1"
              Grid.RowSpan="2"
              Background="{StaticResource Brush.Overlay}"
              Visibility="{Binding State.IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}"
                    Width="420"
                    Padding="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <Grid Width="54"
                          Height="54"
                          HorizontalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform />
                        </Grid.RenderTransform>
                        <Ellipse Stroke="{StaticResource Brush.SurfaceHover}" StrokeThickness="5" />
                        <Ellipse Stroke="{StaticResource Brush.Accent}"
                                 StrokeDashArray="9 7"
                                 StrokeDashCap="Round"
                                 StrokeThickness="5" />
                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0"
                                                         To="360"
                                                         Duration="0:0:1.3"
                                                         RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                    </Grid>

                    <TextBlock Margin="0,20,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource Text.Section}"
                               Text="Выполняется работа" />
                    <TextBlock Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource Text.Body}"
                               Text="{Binding State.BusyText}"
                               TextAlignment="Center" />
                    <TextBlock Margin="0,14,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource Text.Caption}"
                               Text="Ничего не меняем в системе — только имитация"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
