<UserControl x:Class="SlurpPcBoost.Views.OptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:SlurpPcBoost.Converters"
             d:DesignHeight="760"
             d:DesignWidth="1060"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:FilterEqualsConverter x:Key="FilterEquals" />
    </UserControl.Resources>

    <ScrollViewer Padding="0,0,8,0"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Панель управления оптимизацией -->
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Title}" Text="Оптимизация Windows для игр" />
                            <TextBlock Style="{StaticResource Text.Body}"
                                       Margin="0,10,0,0"
                                       MaxWidth="620"
                                       HorizontalAlignment="Left"
                                       Text="Каждый пункт меняет одну настройку системы. В демо-режиме переключатели только имитируют применение и записывают шаги в журнал." />
                        </StackPanel>
                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{StaticResource Brush.AccentSoft}"
                                CornerRadius="11"
                                Padding="14,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Label}" Text="АКТИВНО" />
                                <TextBlock Margin="0,4,0,0"
                                           FontFamily="{StaticResource Font.Numeric}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Accent}"
                                           Text="{Binding State.AppliedCountText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Command="{Binding ApplyAllCommand}"
                                Content="Применить все твики"
                                Style="{StaticResource Btn.Primary}" />
                        <Button Command="{Binding ApplyRecommendedCommand}"
                                Content="Рекомендованные"
                                Style="{StaticResource Btn.Ghost}"
                                Margin="10,0,0,0"
                                ToolTip="Только безопасные настройки без риска" />
                        <Button Command="{Binding ToggleGameModeCommand}"
                                Style="{StaticResource Btn.Ghost}"
                                Margin="10,0,0,0">
                            <TextBlock FontWeight="SemiBold" Text="{Binding State.GameModeText}" />
                        </Button>
                        <Button Command="{Binding RevertAllCommand}"
                                Content="Откатить всё"
                                Style="{StaticResource Btn.Ghost}"
                                Margin="10,0,0,0" />
                    </StackPanel>

                    <!-- Фильтр по категориям -->
                    <ItemsControl ItemsSource="{Binding Categories}" Margin="0,20,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             CommandParameter="{Binding}"
                                             GroupName="TweakCategories"
                                             Style="{StaticResource Chip.Radio}"
                                             Content="{Binding}">
                                    <RadioButton.IsChecked>
                                        <MultiBinding Converter="{StaticResource FilterEquals}" Mode="OneWay">
                                            <Binding Path="." />
                                            <Binding Path="DataContext.SelectedCategory" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                        </MultiBinding>
                                    </RadioButton.IsChecked>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Группы твиков -->
            <ItemsControl ItemsSource="{Binding VisibleGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10"
                                                 Height="10"
                                                 Fill="{Binding Brush}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Margin="10,0,0,0"
                                                   Style="{StaticResource Text.Section}"
                                                   Text="{Binding Name}" />
                                        <Border Background="{StaticResource Brush.SurfaceAlt}"
                                                CornerRadius="8"
                                                Padding="9,4"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.TextMuted}"
                                                       Text="{Binding CountText}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource Font.Numeric}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Green}"
                                               Text="{Binding ImpactText}" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Brush.SurfaceAlt}"
                                                    BorderBrush="{StaticResource Brush.StrokeSoft}"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Margin="0,0,0,10"
                                                    Padding="16">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Brush.Text}"
                                                                       Text="{Binding Title}"
                                                                       VerticalAlignment="Center" />
                                                            <Border Background="{StaticResource Brush.SurfaceHover}"
                                                                    BorderBrush="{StaticResource Brush.Stroke}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="7"
                                                                    Padding="8,3"
                                                                    Margin="10,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVis}}"
                                                                    ToolTip="В реальном приложении такие твики стоит применять осознанно">
                                                                <TextBlock FontSize="10.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource Brush.Yellow}"
                                                                           Text="{Binding RiskText}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Style="{StaticResource Text.Body}"
                                                                   Margin="0,7,20,0"
                                                                   Text="{Binding Description}" />
                                                        <TextBlock Style="{StaticResource Text.Caption}"
                                                                   Margin="0,7,0,0"
                                                                   Text="{Binding StateText}" />
                                                    </StackPanel>

                                                    <Border Grid.Column="1"
                                                            Background="{StaticResource Brush.GreenSoft}"
                                                            CornerRadius="9"
                                                            Padding="10,6"
                                                            Margin="0,0,16,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock FontSize="11.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource Brush.Green}"
                                                                   Text="{Binding ImpactText}" />
                                                    </Border>

                                                    <CheckBox Grid.Column="2"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding IsApplied, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              IsEnabled="{Binding IsEnabled}"
                                                              Style="{StaticResource Switch}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
