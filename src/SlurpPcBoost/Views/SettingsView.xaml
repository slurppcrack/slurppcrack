<UserControl x:Class="SlurpPcBoost.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:SlurpPcBoost.Converters"
             d:DesignHeight="760"
             d:DesignWidth="1060"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer Padding="0,0,8,0"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Демо-режим -->
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40"
                                Height="40"
                                Background="{StaticResource Brush.AccentSoft}"
                                CornerRadius="12">
                            <Path Width="20"
                                  Height="20"
                                  Data="{StaticResource Icon.Alert}"
                                  Fill="{StaticResource Brush.Accent}"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.Title}" Text="Демонстрационный режим" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Безопасно: ничего не меняется в системе" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,18,0,0" Text="{Binding DemoText}" />

                    <Border Background="{StaticResource Brush.SurfaceAlt}"
                            BorderBrush="{StaticResource Brush.StrokeSoft}"
                            BorderThickness="1"
                            CornerRadius="13"
                            Padding="16"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="КАК СДЕЛАТЬ ИЗ ЭТОГО НАСТОЯЩИЙ ОПТИМИЗАТОР" />
                            <TextBlock Style="{StaticResource Text.Body}" Margin="0,8,0,0" Text="{Binding RealModeHint}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Поведение -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Section}" Text="Поведение приложения" />

                        <Grid Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text}"
                                           Text="Авто-оптимизация" />
                                <TextBlock Style="{StaticResource Text.Caption}"
                                           Margin="0,4,0,0"
                                           Text="Следить за фоном и писать наблюдения в журнал" />
                            </StackPanel>
                            <CheckBox HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding State.IsAutoMode, Mode=TwoWay}"
                                      Style="{StaticResource Switch}" />
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text}"
                                           Text="Мониторинг FPS" />
                                <TextBlock Style="{StaticResource Text.Caption}"
                                           Margin="0,4,0,0"
                                           Text="{Binding State.FpsStatusText}" />
                            </StackPanel>
                            <CheckBox HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding State.IsPaused, Mode=OneWay}"
                                      Command="{Binding TogglePauseCommand}"
                                      Style="{StaticResource Switch}" />
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text}"
                                           Text="Игровой режим" />
                                <TextBlock Style="{StaticResource Text.Caption}"
                                           Margin="0,4,0,0"
                                           Text="{Binding State.GameModeText}" />
                            </StackPanel>
                            <CheckBox HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding State.IsGameMode, Mode=OneWay}"
                                      Command="{Binding ToggleGameModeCommand}"
                                      Style="{StaticResource Switch}" />
                        </Grid>

                        <StackPanel Margin="0,20,0,0">
                            <TextBlock FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text}"
                                       Text="Профиль оптимизации" />
                            <TextBlock Style="{StaticResource Text.Caption}"
                                       Margin="0,4,0,0"
                                       Text="Насколько агрессивно применять твики" />
                            <ComboBox Margin="0,10,0,0"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Presets}"
                                      SelectedItem="{Binding Preset, Mode=TwoWay}"
                                      Style="{StaticResource Combo}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Command="{Binding ResetStatsCommand}"
                                    Content="Сбросить статистику"
                                    Style="{StaticResource Btn.Soft}" />
                            <Button Command="{Binding RevertAllCommand}"
                                    Content="Откатить все твики"
                                    Style="{StaticResource Btn.Soft}"
                                    Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Section}" Text="Журнал и устройство" />

                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,14,0,0" Text="{Binding DeviceHeadline}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" Text="{Binding DeviceSubline}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0" Text="{Binding PrivilegesText}" />

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Command="{Binding SaveLogCommand}"
                                    Content="Сохранить журнал"
                                    Style="{StaticResource Btn.Soft}" />
                            <Button Command="{Binding OpenLogFolderCommand}"
                                    Content="Открыть папку"
                                    Style="{StaticResource Btn.Soft}"
                                    Margin="10,0,0,0" />
                            <Button Command="{Binding ClearLogCommand}"
                                    Content="Очистить"
                                    Style="{StaticResource Btn.Soft}"
                                    Margin="10,0,0,0" />
                        </StackPanel>

                        <Border Background="{StaticResource Brush.SurfaceAlt}"
                                BorderBrush="{StaticResource Brush.StrokeSoft}"
                                BorderThickness="1"
                                CornerRadius="13"
                                Padding="14"
                                Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Label}" Text="СТАТИСТИКА СЕССИИ" />
                                <Grid Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="Применено твиков" />
                                    <TextBlock HorizontalAlignment="Right"
                                               FontFamily="{StaticResource Font.Numeric}"
                                               FontSize="13"
                                               Foreground="{StaticResource Brush.Text}"
                                               Text="{Binding State.AppliedCountText}" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="Оценка прироста" />
                                    <TextBlock HorizontalAlignment="Right"
                                               FontFamily="{StaticResource Font.Numeric}"
                                               FontSize="13"
                                               Foreground="{StaticResource Brush.Accent}"
                                               Text="{Binding State.BoostPercentText}" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="Ошибок в журнале" />
                                    <TextBlock HorizontalAlignment="Right"
                                               FontFamily="{StaticResource Font.Numeric}"
                                               FontSize="13"
                                               Foreground="{StaticResource Brush.Text}"
                                               Text="{Binding State.Log.ErrorCount}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- О приложении -->
            <Border Style="{StaticResource Card}" Padding="24">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Section}" Text="О программе" />
                    <TextBlock Style="{StaticResource Text.Body}"
                               Margin="0,14,0,0"
                               Text="Slurp PC Boost — учебный демонстрационный проект: интерфейс оптимизатора ПК для геймеров, написанный на WPF (.NET 8) с архитектурой MVVM." />
                    <TextBlock Style="{StaticResource Text.Body}"
                               Margin="0,10,0,0"
                               Text="В демо-версии вся логика оптимизации заменена имитацией: приложение не обращается к реестру, службам Windows, схемам питания и сетевым настройкам, а лишь показывает, как это выглядело бы." />

                    <ItemsControl Margin="0,18,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Items>
                            <Border Style="{StaticResource Card.Flat}" Padding="13,9" Margin="0,0,10,10">
                                <TextBlock Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text}">
                                    <Run Text="Версия: " />
                                    <Run FontWeight="Bold" Text="{Binding State.System.AppVersionText, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource Card.Flat}" Padding="13,9" Margin="0,0,10,10">
                                <TextBlock Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text}">
                                    <Run Text="Платформа: WPF • .NET 8 • " />
                                    <Run FontWeight="Bold" Text="{Binding State.System.OsArch, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource Card.Flat}" Padding="13,9" Margin="0,0,10,10">
                                <TextBlock Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text}">
                                    <Run Text="Устройство: " />
                                    <Run FontWeight="Bold" Text="{Binding State.System.MachineName, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource Card.Flat}" Padding="13,9" Margin="0,0,10,10">
                                <TextBlock Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text}">
                                    <Run Text="Архитектура: MVVM без внешних библиотек" />
                                </TextBlock>
                            </Border>
                        </ItemsControl.Items>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
