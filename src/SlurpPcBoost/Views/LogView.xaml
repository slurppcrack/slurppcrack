<UserControl x:Class="SlurpPcBoost.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:SlurpPcBoost.Models"
             d:DesignHeight="760"
             d:DesignWidth="1060"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="24" Margin="0,0,0,16">
            <Grid>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Title}" Text="Журнал событий" />
                    <TextBlock Style="{StaticResource Text.Body}"
                               Margin="0,10,0,0"
                               MaxWidth="620"
                               HorizontalAlignment="Left"
                               Text="Здесь видно, что именно делало приложение: применение твиков, сканирование, предупреждения демо-режима." />
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Style="{StaticResource Card.Flat}" Padding="12,9" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="ЗАПИСЕЙ" />
                            <TextBlock Margin="0,4,0,0"
                                       FontFamily="{StaticResource Font.Numeric}"
                                       FontSize="15"
                                       Foreground="{StaticResource Brush.Text}"
                                       Text="{Binding Entries.Count}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card.Flat}" Padding="12,9">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="ОШИБОК" />
                            <TextBlock Margin="0,4,0,0"
                                       FontFamily="{StaticResource Font.Numeric}"
                                       FontSize="15"
                                       Foreground="{StaticResource Brush.Red}"
                                       Text="{Binding State.Log.ErrorCount}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Button Command="{Binding SaveCommand}"
                            Content="Сохранить в файл"
                            Style="{StaticResource Btn.Soft}" />
                    <Button Command="{Binding ClearCommand}"
                            Content="Очистить журнал"
                            Style="{StaticResource Btn.Soft}"
                            Margin="10,0,0,0" />
                    <Button Command="{Binding BackCommand}"
                            Style="{StaticResource Btn.Soft}"
                            Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14"
                                  Height="14"
                                  Data="{StaticResource Icon.ArrowLeft}"
                                  Fill="{StaticResource Brush.TextMuted}"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center" />
                            <TextBlock Margin="8,0,0,0" FontWeight="SemiBold" Text="Назад к обзору" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ScrollViewer x:Name="LogScroll"
                              Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Padding="0,0,8,0">
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Brush.SurfaceAlt}"
                                        BorderBrush="{StaticResource Brush.StrokeSoft}"
                                        BorderThickness="1"
                                        CornerRadius="11"
                                        Margin="0,0,0,8"
                                        Padding="14,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="Badge"
                                                Background="{StaticResource Brush.SurfaceHover}"
                                                CornerRadius="7"
                                                Padding="9,3"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="LevelText"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource Brush.TextDim}"
                                                       Text="{Binding LevelText}" />
                                        </Border>

                                        <TextBlock Grid.Column="1"
                                                   Margin="12,0,12,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Font.Numeric}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource Brush.TextDim}"
                                                   Text="{Binding TimeText}" />

                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   FontSize="12.5"
                                                   Foreground="{StaticResource Brush.Text}"
                                                   Text="{Binding Message}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Success}">
                                        <Setter TargetName="Badge" Property="Background" Value="{StaticResource Brush.GreenSoft}" />
                                        <Setter TargetName="LevelText" Property="Foreground" Value="{StaticResource Brush.Green}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Warning}">
                                        <Setter TargetName="Badge" Property="Background" Value="#26FFD166" />
                                        <Setter TargetName="LevelText" Property="Foreground" Value="{StaticResource Brush.Yellow}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Error}">
                                        <Setter TargetName="Badge" Property="Background" Value="#26FF5C72" />
                                        <Setter TargetName="LevelText" Property="Foreground" Value="{StaticResource Brush.Red}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Detail}">
                                        <Setter TargetName="LevelText" Property="Foreground" Value="{StaticResource Brush.Blue}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
