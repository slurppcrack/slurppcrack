{
  "name": "slurp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SLURP — the agentic coding environment for vibe coding",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build:app": "node scripts/build-single.mjs && node scripts/build-exe.mjs",
    "build:exe": "node scripts/build-exe.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.0",
    "@fontsource-variable/space-grotesk": "^5.1.0",
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  },
  "engines": {
    "node": ">=18.17"
  }
}
